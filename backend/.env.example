# Backend Environment Configuration
PROJECT_NAME="Epilepsy Detection API"
ENVIRONMENT="production"
PORT=8000

# Security & Authentication
JWT_SECRET="replace-with-a-secure-random-32-character-secret-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Leave empty for local SQLite fallback, or provide Railway PostgreSQL connection string)
# DATABASE_URL="postgresql://postgres:password@roundhouse.proxy.rlwy.net:5432/railway"

# CORS Configuration (Comma-separated origins)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://your-frontend-app.vercel.app"