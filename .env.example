# ==========================================
# EpiDetect AI — Production Environment Configuration
# ==========================================

# 1. Application Settings
PROJECT_NAME="Epilepsy Detection API"
ENVIRONMENT="production"
PORT=8000

# 2. Security & Authentication
# Generate a secure 32+ character key using: openssl rand -hex 32
JWT_SECRET="replace-with-a-secure-random-32-character-secret-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. Database Configuration
# Leave empty for default local SQLite engine, or provide PostgreSQL connection string for Railway
# DATABASE_URL="postgresql://postgres:password@roundhouse.proxy.rlwy.net:5432/railway"

# 4. CORS Origins (Comma-separated list of allowed web clients)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://your-epidetect-app.vercel.app"

# 5. Frontend Client Configuration (Vercel / Local)
# VITE_API_URL="https://your-epidetect-backend.up.railway.app"
